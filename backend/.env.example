# Digital Guardians Backend Configuration
# Copy this to .env and fill in your values

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/digitalguardians
DATABASE_POOL_SIZE=20

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# AI Services
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL=gpt-4-turbo
AI_FALLBACK_MODEL=claude-3-sonnet

# URL Scanning Services
GOOGLE_SAFE_BROWSING_KEY=your_google_safe_browsing_key
VIRUSTOTAL_API_KEY=your_virustotal_api_key

# Text-to-Speech (optional - uses Web Speech API if not configured)
GOOGLE_TTS_CREDENTIALS_PATH=./config/gcp-credentials.json

# Email Service (for magic links)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@digitalguardians.ca

# Security
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d
ENCRYPTION_KEY=your_32_character_encryption_key

# Rate Limiting
RATE_LIMIT_ANONYMOUS=10
RATE_LIMIT_WINDOW_MS=60000

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
